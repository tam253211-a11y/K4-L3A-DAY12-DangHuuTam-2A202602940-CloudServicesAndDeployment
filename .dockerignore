# Những thứ KHÔNG được đưa vào build context / image.
# Thiếu .env ở đây = secret nằm luôn trong image.

# Secrets
.env
.env.*
*.pem
*.key

# Git
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần khi chạy service
tests
screenshots
nginx
*.md
grade.py
docker-compose.yml
render.yaml
railway.toml

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode
*.log
